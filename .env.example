# Copy to `.env` for local runs; on Railway set these as service variables.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_TEMPERATURE=0.5
OPENROUTER_REASONING_EFFORT=medium
# Required: HTTP Basic credentials guarding the whole site (the app refuses to start without them).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
# Optional: Railway provides `PORT` automatically at runtime.
# PORT=8000
